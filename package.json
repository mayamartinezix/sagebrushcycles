{
  "name": "sagebrushcycles",
  "version": "1.0.0",
  "private": true,
  "description": "Sagebrush Cycle website — source + build",
  "scripts": {
    "build": "node build.mjs",
    "preview": "npm run build && node --eval \"const http=require('node:http'),fs=require('node:fs'),p=require('node:path');const t={'.html':'text/html','.js':'text/javascript','.css':'text/css','.svg':'image/svg+xml','.jpg':'image/jpeg','.ttf':'font/ttf'};http.createServer((q,s)=>{let f=p.join('public',q.url==='/'?'index.html':q.url.slice(1));fs.readFile(f,(e,d)=>{if(e){s.statusCode=404;return s.end('404')}s.setHeader('content-type',t[p.extname(f)]||'application/octet-stream');s.end(d)})}).listen(8080,()=>console.log('http://localhost:8080'))\""
  },
  "devDependencies": {
    "esbuild": "^0.24.2"
  }
}
