# The image builds from src/ via build.mjs, so the build context needs src/,
# package*.json and build.mjs — but not these:
node_modules
public
.git
.github
deploy
README.md
*.swp

# …but the prep image bakes wp-config.php (single source, also used to generate
# the serving container's ConfigMap), so let that one file through.
!deploy/wp-config.php
