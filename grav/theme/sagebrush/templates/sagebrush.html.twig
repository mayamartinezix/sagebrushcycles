{#
  Sagebrush Cycle page template.

  Emits a self-contained HTML document that loads the prebuilt React-on-globals
  bundle (app.js) from this theme's site/ directory and injects window.SB_CONTENT
  from the page header (page.header.content). app.js itself is content-free and
  renders whatever SB_CONTENT it finds, so editing the page in Grav admin /
  expert mode changes the rendered site.

  The <base href> points at where the built public/ files were copied during the
  Docker build: /user/themes/sagebrush/site/. Every relative ref in the doc and
  inside the CSS (fonts/..., assets/...) resolves against it.
#}
{# url() strips the trailing slash; <base href> MUST end in '/' or relative
   refs resolve one dir too high (.../sagebrush/app.js instead of
   .../sagebrush/site/app.js). Trim any trailing slash and add exactly one. #}
{%- set site = url('theme://site', true)|trim('/') ~ '/' -%}
{%- set content = page.header.content -%}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Sagebrush Cycle — Bike rentals on the Weiser Trail</title>
  <meta name="description" content="Easygoing half- and full-day bike rentals right by the Weiser Trail. Reserve online or give us a call.">
  <base href="{{ site }}">
  <link rel="icon" href="assets/emblem.svg" type="image/svg+xml">
  <link rel="stylesheet" href="colors_and_type.css">
  <link rel="stylesheet" href="site.css">
</head>
<body>
  <div id="root"></div>
  {# json_encode's default escaping (\/ and \uXXXX) is valid JS string syntax,
     so the injected object renders identically; |raw keeps it as a JS literal. #}
  <script>window.SB_CONTENT = {{ content|json_encode|raw }};</script>
  <script src="app.js"></script>
</body>
</html>
